# Runtime secrets are stored in Cloudflare Pages Settings > Variables and Secrets.
# Never place real credentials in this file or in GitHub.
# AMAZON_CLIENT_ID= (secret)
# AMAZON_CLIENT_SECRET= (secret)
# AMAZON_PARTNER_TAG= (configure as secret)
# AMAZON_CREDENTIAL_VERSION=3.2 (plain variable)
# AMAZON_MARKETPLACE=www.amazon.in (plain variable)
# VELORA_ADMIN_TOKEN= (secret; generate 32+ random characters in a password manager)
# D1 binding name: DB (configured in Cloudflare Pages dashboard)
